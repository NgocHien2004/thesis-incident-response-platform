<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="IR Platform" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_4">
    <bpmn:participant id="Pool_4" name="BPMN 4. Eradication và recovery → xác nhận của chủ hệ thống (bước 9)" processRef="Process_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_4" name="BPMN 4. Eradication và recovery → xác nhận của chủ hệ thống (bước 9)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_4">
      <bpmn:lane id="Lane_IT" name="IT / Helpdesk (hoặc Analyst)">
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SY" name="Hệ thống (tự động)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ST" name="Stakeholder (chủ hệ thống)">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Incident đã khống chế (contained)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="r1" name="Tạo hành động recovery: loại, mô tả, người phụ trách">
      <bpmn:documentation>POST /incidents/{id}/recovery/. IT hoặc Analyst. Chỉ khi incident contained hoặc recovering. Loại: remove_malware, patch_vulnerability, restore_backup, reset_credentials, rebuild_system, re_enable_service, other. Eradication và recovery dùng chung một đối tượng.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="r2" name="Thực hiện, cập nhật tiến độ (in_progress)">
      <bpmn:documentation>PATCH .../recovery/{id}/status. IT hoặc Analyst. Trạng thái: pending, in_progress, done, failed.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gr" name="Kết quả?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="r3" name="Đánh dấu done (ghi người, thời điểm)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="r4" name="Đánh dấu failed, ghi chú">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="s2" name="Kiểm tra hệ thống đã phục hồi">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="s3" name="Xác nhận recovery (confirm_note)">
      <bpmn:documentation>PATCH .../recovery/{id}/confirm. Chỉ Stakeholder; chỉ trên action đã done. Analyst không xác nhận thay. Hiện mọi Stakeholder đều xác nhận được mọi recovery (chưa gắn với tài sản).</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ga" name="Mọi recovery đã được xác nhận?">
      <bpmn:documentation>Kiểm tra trên tất cả action của vụ. Một action failed không bao giờ được xác nhận sẽ làm điều kiện này không đạt, trong khi tiêu chí đóng vụ bỏ qua action failed.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t1" name="Vụ contained → tự chuyển recovering">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Sẵn sàng đóng vụ (bước 11)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s1" targetRef="r1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="r1" targetRef="r2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="r2" targetRef="gr" />
    <bpmn:sequenceFlow id="Flow_4" name="Hoàn thành" sourceRef="gr" targetRef="r3" />
    <bpmn:sequenceFlow id="Flow_5" name="Thất bại" sourceRef="gr" targetRef="r4" />
    <bpmn:sequenceFlow id="Flow_6" name="Thử lại" sourceRef="r4" targetRef="r2" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="r3" targetRef="s2" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="s2" targetRef="s3" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="s3" targetRef="ga" />
    <bpmn:sequenceFlow id="Flow_10" name="Có" sourceRef="ga" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t1" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_12" name="Chưa đủ" sourceRef="ga" targetRef="r2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_4">
    <bpmndi:BPMNPlane id="Plane_4" bpmnElement="Collab_4">
      <bpmndi:BPMNShape id="Pool_4_di" bpmnElement="Pool_4" isHorizontal="true"><dc:Bounds x="20" y="20" width="1750" height="570" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IT_di" bpmnElement="Lane_IT" isHorizontal="true"><dc:Bounds x="50" y="20" width="1720" height="230" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SY_di" bpmnElement="Lane_SY" isHorizontal="true"><dc:Bounds x="50" y="250" width="1720" height="190" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ST_di" bpmnElement="Lane_ST" isHorizontal="true"><dc:Bounds x="50" y="440" width="1720" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="112" y="327" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="65" y="367" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r1_di" bpmnElement="r1"><dc:Bounds x="235" y="100" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r2_di" bpmnElement="r2"><dc:Bounds x="405" y="100" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gr_di" bpmnElement="gr" isMarkerVisible="true"><dc:Bounds x="615" y="110" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="505" y="64" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r3_di" bpmnElement="r3"><dc:Bounds x="745" y="50" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r4_di" bpmnElement="r4"><dc:Bounds x="745" y="150" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_di" bpmnElement="s2"><dc:Bounds x="915" y="480" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s3_di" bpmnElement="s3"><dc:Bounds x="1085" y="480" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ga_di" bpmnElement="ga" isMarkerVisible="true"><dc:Bounds x="1295" y="320" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1185" y="274" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="1425" y="310" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1642" y="327" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1595" y="367" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="130" y="327" />
        <di:waypoint x="130" y="135" />
        <di:waypoint x="235" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="365" y="135" />
        <di:waypoint x="405" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="535" y="135" />
        <di:waypoint x="615" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="640" y="110" />
        <di:waypoint x="640" y="85" />
        <di:waypoint x="745" y="85" />
        <bpmndi:BPMNLabel><dc:Bounds x="645" y="92" width="68" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="640" y="160" />
        <di:waypoint x="640" y="185" />
        <di:waypoint x="745" y="185" />
        <bpmndi:BPMNLabel><dc:Bounds x="645" y="164" width="56" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="810" y="220" />
        <di:waypoint x="810" y="238" />
        <di:waypoint x="470" y="238" />
        <di:waypoint x="470" y="170" />
        <bpmndi:BPMNLabel><dc:Bounds x="815" y="224" width="49" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="875" y="85" />
        <di:waypoint x="980" y="85" />
        <di:waypoint x="980" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1045" y="515" />
        <di:waypoint x="1085" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1150" y="480" />
        <di:waypoint x="1150" y="345" />
        <di:waypoint x="1295" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1345" y="345" />
        <di:waypoint x="1425" y="345" />
        <bpmndi:BPMNLabel><dc:Bounds x="1349" y="327" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1555" y="345" />
        <di:waypoint x="1642" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1320" y="370" />
        <di:waypoint x="1320" y="418" />
        <di:waypoint x="470" y="418" />
        <di:waypoint x="470" y="170" />
        <bpmndi:BPMNLabel><dc:Bounds x="1325" y="374" width="49" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
