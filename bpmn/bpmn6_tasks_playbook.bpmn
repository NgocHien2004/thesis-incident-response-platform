      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="405" y="535" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a2_di" bpmnElement="a2"><dc:Bounds x="575" y="70" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i1_di" bpmnElement="i1"><dc:Bounds x="745" y="360" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="955" y="370" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="845" y="324" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i2_di" bpmnElement="i2"><dc:Bounds x="1085" y="360" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1125" y="80" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1015" y="34" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c1_di" bpmnElement="c1"><dc:Bounds x="1255" y="220" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a3_di" bpmnElement="a3"><dc:Bounds x="1255" y="70" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gm_di" bpmnElement="gm" isMarkerVisible="true"><dc:Bounds x="1465" y="545" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="1595" y="535" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g4_di" bpmnElement="g4" isMarkerVisible="true"><dc:Bounds x="1805" y="545" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1695" y="499" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1982" y="552" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1935" y="592" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="148" y="105" />
