<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_6" targetNamespace="http://bpmn.io/schema/bpmn" exporter="IR Platform" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_6">
    <bpmn:participant id="Pool_6" name="BPMN 6. Công việc theo playbook: áp dụng → giao việc → thực hiện hoặc bỏ qua → điều kiện đóng vụ" processRef="Process_6" />
  </bpmn:collaboration>
  <bpmn:process id="Process_6" name="BPMN 6. Công việc theo playbook: áp dụng → giao việc → thực hiện hoặc bỏ qua → điều kiện đóng vụ" isExecutable="false">
    <bpmn:laneSet id="LaneSet_6">
      <bpmn:lane id="Lane_AN" name="Analyst / SOC">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CM" name="Commander của vụ">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT / Helpdesk (hoặc Analyst)">
        <bpmn:flowNodeRef>i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SY" name="Hệ thống (tự động)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Incident đã tạo, cần danh sách công việc">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a1" name="Chọn playbook theo loại sự cố">
      <bpmn:documentation>GET /playbooks/?active_only=true. Playbook là mẫu cấu hình được: mỗi bước có giai đoạn, vai trò thường làm, hạn (giờ từ lúc tạo vụ) và cờ bắt buộc. Chỉ Analyst tạo hoặc sửa playbook.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t1" name="Tạo công việc từ các bước, bỏ qua bước đã có">
      <bpmn:documentation>POST /incidents/{id}/tasks/apply-playbook (hoặc playbook_id lúc tạo incident). Mỗi bước thành một task; hạn = detected_at + due_hours. Bước đã có task cùng playbook và cùng tiêu đề thì không tạo lại. Không áp dụng cho incident đã đóng.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="a2" name="Giao việc, chỉnh hạn, thêm việc thủ công">
      <bpmn:documentation>PATCH /incidents/{id}/tasks/{tid} (assignee_id, due_at) và POST /incidents/{id}/tasks/. Chỉ Analyst. Người được giao phải là IT/Helpdesk hoặc Analyst đang hoạt động.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="i1" name="Nhận việc và thực hiện (in_progress)">
      <bpmn:documentation>IT chỉ làm được việc giao cho mình hoặc việc chưa giao thuộc vai trò IT; nhận việc chưa giao sẽ tự gán cho người nhận. Analyst làm được mọi việc.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Hoàn thành được?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="i2" name="Đánh dấu done">
      <bpmn:documentation>Ghi người hoàn thành và thời điểm. Muốn mở lại việc đã xong phải là Analyst và ghi lý do.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Việc bắt buộc?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="c1" name="Commander bỏ qua kèm lý do">
      <bpmn:documentation>Chỉ commander của vụ được bỏ qua hoặc mở lại công việc bắt buộc. Bắt buộc ghi lý do.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a3" name="Analyst bỏ qua kèm lý do">
      <bpmn:documentation>Công việc không bắt buộc: Analyst bất kỳ được bỏ qua, vẫn phải ghi lý do.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gm">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t2" name="Ghi nhật ký, cập nhật thống kê công việc">
      <bpmn:documentation>Mọi thay đổi công việc đi vào nhật ký kiểm toán và timeline. Dashboard thống kê công việc đang mở và quá hạn của các vụ chưa đóng.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g4" name="Còn việc bắt buộc chưa xử lý?">
      <bpmn:documentation>Tiêu chí đóng vụ thứ 6: không còn công việc bắt buộc ở todo hoặc in_progress.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Đủ điều kiện về công việc để đóng vụ">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s1" targetRef="a1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="a1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t1" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="a2" targetRef="i1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="i1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_6" name="Có" sourceRef="g1" targetRef="i2" />
    <bpmn:sequenceFlow id="Flow_7" name="Không áp dụng" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_8" name="Có" sourceRef="g2" targetRef="c1" />
    <bpmn:sequenceFlow id="Flow_9" name="Không" sourceRef="g2" targetRef="a3" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="i2" targetRef="gm" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="c1" targetRef="gm" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="a3" targetRef="gm" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="gm" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t2" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_15" name="Không" sourceRef="g4" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_16" name="Có" sourceRef="g4" targetRef="i1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_6">
    <bpmndi:BPMNPlane id="Plane_6" bpmnElement="Collab_6">
      <bpmndi:BPMNShape id="Pool_6_di" bpmnElement="Pool_6" isHorizontal="true"><dc:Bounds x="20" y="20" width="2090" height="650" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AN_di" bpmnElement="Lane_AN" isHorizontal="true"><dc:Bounds x="50" y="20" width="2060" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CM_di" bpmnElement="Lane_CM" isHorizontal="true"><dc:Bounds x="50" y="190" width="2060" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IT_di" bpmnElement="Lane_IT" isHorizontal="true"><dc:Bounds x="50" y="320" width="2060" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SY_di" bpmnElement="Lane_SY" isHorizontal="true"><dc:Bounds x="50" y="470" width="2060" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="112" y="87" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="65" y="127" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
