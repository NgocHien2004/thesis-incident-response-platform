        <di:waypoint x="810" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="875" y="395" />
        <di:waypoint x="955" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1005" y="395" />
        <di:waypoint x="1085" y="395" />
        <bpmndi:BPMNLabel><dc:Bounds x="1009" y="377" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
