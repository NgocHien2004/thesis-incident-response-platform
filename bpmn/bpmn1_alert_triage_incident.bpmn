        <di:waypoint x="1005" y="270" />
        <di:waypoint x="1150" y="270" />
        <di:waypoint x="1150" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1215" y="95" />
        <di:waypoint x="1320" y="95" />
        <di:waypoint x="1320" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1385" y="485" />
        <di:waypoint x="1465" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1490" y="460" />
        <di:waypoint x="1490" y="440" />
        <di:waypoint x="1595" y="440" />
        <bpmndi:BPMNLabel><dc:Bounds x="1495" y="442" width="37" height="14" /></bpmndi:BPMNLabel>
