      <bpmndi:BPMNShape id="g3_di" bpmnElement="g3" isMarkerVisible="true"><dc:Bounds x="1305" y="370" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1265" y="326" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
