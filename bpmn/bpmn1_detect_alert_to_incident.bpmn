      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="915" y="395" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="1105" y="405" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1065" y="361" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1235" y="395" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1235" y="495" width="130" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1395" y="512" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1348" y="554" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1405" y="220" width="130" height="70" /></bpmndi:BPMNShape>
